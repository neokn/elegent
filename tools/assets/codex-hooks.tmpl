{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ELEGENT_BIN}} hook codex precompact",
            "statusMessage": "Archiving Codex conversation to EleGent",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ELEGENT_BIN}} hook codex stop",
            "statusMessage": "Archiving Codex conversation to EleGent",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
