{
  "hooks": {
    "Stop": [
      { "hooks": [{ "type": "command", "command": "{{ELEGENT_BIN}} hook stop" }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "{{ELEGENT_BIN}} hook precompact" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "{{ELEGENT_BIN}} hook sessionend" }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "{{ELEGENT_BIN}} hook sessionstart" }] }
    ]
  },
  "permissions": {
    "allow": ["Bash({{ELEGENT_BIN}}:*)"]
  }
}
