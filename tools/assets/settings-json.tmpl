{
  "hooks": {
    "Stop": [
      { "hooks": [{ "type": "command", "command": "{{ELEGENT_BIN}} hook claude stop" }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "{{ELEGENT_BIN}} hook claude precompact" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "{{ELEGENT_BIN}} hook claude sessionend" }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "{{ELEGENT_BIN}} hook claude sessionstart" }] }
    ]
  },
  "permissions": {
    "allow": ["Bash({{ELEGENT_BIN}}:*)"]
  }
}
