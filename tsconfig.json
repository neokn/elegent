{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["bun-types"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["tools/core/*"],
      "@presentation/*": ["tools/presentation/*"],
      "@infrastructure/*": ["tools/infrastructure/*"]
    }
  },
  "include": ["tools/**/*.ts"]
}
